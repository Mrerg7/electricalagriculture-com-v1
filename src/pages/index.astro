---
import Base from "../layouts/BaseLayout.astro";
import { SITE, mailto } from "../config/site";
import { foodMultiples, makers, notes, pathways } from "../data/brief";
---

<Base path="/">
  <main>
    <section class="wrap hero">
      <div>
        <p class="kicker">Field brief · {SITE.sourceDate}</p>
        <h1 class="display">Turn current into calories.</h1>
        <p class="lede">
          Plants keep less than one percent of sunlight. A panel keeps more than twenty. The distance
          between those numbers is a new agriculture — food from electricity, not from another cleared acre.
        </p>
        <div class="actions">
          <a class="btn" href="/science/">How the current becomes food</a>
          <a class="btn-ghost" href={mailto("buy")}>Buy the domain · {SITE.priceFormatted}</a>
        </div>
      </div>
      <figure>
        <img
          src="/photos/bioreactor.jpg"
          width="1792"
          height="1008"
          alt="Stainless bioreactors in a quiet laboratory hall, a sight glass showing pale green culture"
        />
        <figcaption class="caption">A tank, not a season. Microbial protein is already leaving pilot scale.</figcaption>
      </figure>
    </section>

    <section class="wrap">
      <dl class="stats">
        <div><dt><1%</dt><dd>of sunlight a field turns into food</dd></div>
        <div><dt>18×</dt><dd>yeast on acetate, versus farming</dd></div>
        <div><dt>>⅓</dt><dd>of emissions come from producing food</dd></div>
        <div><dt>{SITE.priceFormatted}</dt><dd>listed price, one .com</dd></div>
      </dl>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">Five routes</p>
          <h2 class="display" style="font-size:clamp(2rem,4vw,3rem)">Same sun. Different spoon.</h2>
        </div>
        <a class="text-link" href="/science/">The full path</a>
      </div>
      <ol class="cards" style="list-style:none;padding:0;margin-top:1.4rem">
        {pathways.map((path, index) => (
          <li class="card">
            <p class="num">0{index + 1}</p>
            <h3>{path.title}</h3>
            <p class="muted">{path.lede}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap split">
      <figure class="figure">
        <p class="kicker">Figure 02</p>
        <h2 style="font-size:1.7rem;margin-top:0.3rem">Sunlight to food, relative to a field</h2>
        <div class="bars">
          {foodMultiples.map((row) => (
            <div>
              <div class="row"><span>{row.name}</span><span>{row.multiple}×</span></div>
              <div class="barline"><span style={`width:${(row.multiple / 18) * 100}%`}></span></div>
            </div>
          ))}
        </div>
        <p class="caption">Illustrative bars from the reported ratios. Crops = 1. Not a new measurement.</p>
      </figure>
      <figure class="card" style="padding:0;overflow:hidden">
        <img src="/photos/protein.jpg" width="1600" height="1200" alt="A ceramic bowl of fine ivory protein powder on linen" style="aspect-ratio:4/3;object-fit:cover;width:100%" loading="lazy" />
        <figcaption class="caption" style="padding:0 1rem 1rem">Solein is a powder. Solar Foods is targeting a few dollars a kilogram.</figcaption>
      </figure>
    </section>

    <section class="wrap section">
      <div class="figure">
        <p class="kicker">Figure 03</p>
        <h2 style="font-size:clamp(1.8rem,3vw,2.4rem)">If some calories left the field</h2>
        <p class="muted">At an 18× advantage, those calories would need about one-eighteenth of the cropland they use now. A sketch — not a claim the grid can spare the power.</p>
        <label for="share">Share moved onto an acetate–yeast route: <strong id="share-label">20%</strong></label>
        <input class="meter" id="share" type="range" min="0" max="40" value="20" />
        <div class="metrics">
          <div class="metric"><span class="muted">Cropland those calories use today</span><strong id="m-today">20%</strong></div>
          <div class="metric"><span class="muted">Land the electric route would need</span><strong id="m-need">1.1%</strong></div>
          <div class="metric hot"><span>Illustrative land retired</span><strong id="m-free">18.9%</strong></div>
        </div>
      </div>
    </section>

    <section class="wrap section">
      <div class="section-head">
        <div>
          <p class="kicker">Who is building it</p>
          <h2 class="display" style="font-size:clamp(2rem,4vw,3rem)">Makers, not metaphors.</h2>
        </div>
        <a class="text-link" href="/makers/">Filter the field</a>
      </div>
      <ul class="makers">
        {makers.slice(0, 5).map((maker) => (
          <li>
            <strong>{maker.name}</strong>
            <span class="muted">{maker.place}</span>
            <span>{maker.pathway}</span>
            <span class="muted">{maker.status}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="wrap section">
      <p class="kicker">Notes</p>
      <h2 class="display" style="font-size:clamp(2rem,4vw,3rem)">Read the argument.</h2>
      <div class="notes" style="margin-top:1.2rem">
        {notes.map((note) => (
          <a class="card note" href={`/notes/${note.slug}/`}>
            <p class="kicker">{note.kicker}</p>
            <h3>{note.title}</h3>
            <p class="muted">{note.dek}</p>
            <p><strong>{note.minutes} min</strong></p>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap section">
      <div class="band">
        <div>
          <p class="kicker" style="color:inherit;opacity:0.7">The name</p>
          <h2>electricalagriculture.com</h2>
          <p>Category language for a category that just became legible. Listed at {SITE.priceFormatted}. No cart, no countdown — an email, then escrow.</p>
        </div>
        <div class="stack">
          <a class="btn" href={mailto("buy")}>Buy now</a>
          <a class="btn-line" href="/acquire/">Make an offer</a>
          <a href={mailto("contact")} style="text-align:center">Contact</a>
        </div>
      </div>
    </section>
  </main>
</Base>
