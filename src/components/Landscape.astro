---
import { SITE } from '../config/site';
---

<section id="landscape" class="relative z-10 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 py-20 sm:py-28">
    <div class="max-w-3xl">
      <p class="section-label mb-4">The landscape</p>
      <h2 class="font-display text-3xl sm:text-5xl font-semibold tracking-tight leading-[1.1] mb-6">
        Agriculture is plugging in
      </h2>
      <p class="text-lg sm:text-xl text-[var(--text-muted)] leading-relaxed mb-8">
        Electrical agriculture describes the transition of farm power — from diesel engines to electric drivetrains,
        battery systems, and on-farm energy infrastructure — as growers pursue lower emissions, quieter operations, and
        machines that speak the language of autonomy.
      </p>
      <p class="text-[var(--text-muted)] leading-relaxed">
        As of <span class="text-white font-medium">{SITE.asOfDate}</span>, public research and trade reporting show
        electrified tractors and farm equipment delivering
        <span class="text-harvest-300 font-semibold">39% to 72% well-to-wheels energy efficiency</span>
        versus roughly <span class="text-white font-medium">25% to 37%</span> for traditional combustion — a structural
        advantage when duty cycles and charging fit the work.
      </p>
    </div>

    <dl class="mt-14 grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-6 border-t border-white/10 pt-10">
      <div>
        <dt class="text-xs uppercase tracking-[0.22em] text-[var(--text-muted)] mb-2">Efficiency band</dt>
        <dd class="font-display text-3xl sm:text-4xl text-harvest-300 font-semibold">39–72%</dd>
        <p class="mt-2 text-sm text-[var(--text-muted)]">Well-to-wheels for electrified equipment</p>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.22em] text-[var(--text-muted)] mb-2">Combustion baseline</dt>
        <dd class="font-display text-3xl sm:text-4xl text-white font-semibold">25–37%</dd>
        <p class="mt-2 text-sm text-[var(--text-muted)]">Typical diesel engine efficiency range</p>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-[0.22em] text-[var(--text-muted)] mb-2">Near-term focus</dt>
        <dd class="font-display text-3xl sm:text-4xl text-volt-400 font-semibold">Utility HP</dd>
        <p class="mt-2 text-sm text-[var(--text-muted)]">Compact & specialty fleets lead adoption</p>
      </div>
    </dl>
  </div>
</section>
