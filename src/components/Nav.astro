---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-field-950/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-6" aria-label="Primary">
    <a href="/" class="group flex items-center gap-3 min-w-0">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-harvest-500 to-volt-500 text-field-950 font-display font-bold text-sm"
        aria-hidden="true"
      >
        EA
      </span>
      <span class="truncate">
        <span class="block font-display text-lg sm:text-xl font-semibold tracking-tight leading-none group-hover:text-harvest-300 transition-colors">
          {SITE.brand}
        </span>
        <span class="block text-[10px] uppercase tracking-[0.22em] text-[var(--text-muted)] mt-0.5">.com</span>
      </span>
    </a>

    <div class="hidden md:flex items-center gap-8 text-sm text-[var(--text-muted)]">
      <a href="#landscape" class="hover:text-white transition-colors">Landscape</a>
      <a href="#topics" class="hover:text-white transition-colors">Topics</a>
      <a href="#insights" class="hover:text-white transition-colors">Insights</a>
    </div>

    <a
      href={ACQUISITION_MAILTO}
      class="inline-flex items-center gap-2 rounded-full bg-harvest-500 px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-field-950 hover:bg-harvest-300 transition-colors"
    >
      <span class="hidden sm:inline">Inquire</span>
      <span class="sm:hidden">Acquire</span>
      <span aria-hidden="true">→</span>
    </a>
  </nav>
</header>
